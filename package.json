{
	"name": "electrobun-react-tailwind-vite",
	"version": "1.0.0",
	"description": "Electrobun app with React, Tailwind CSS, and Vite HMR",

	"scripts": {
		"start": "vite build && electrobun dev",
		"dev": "bun run watch-routes & electrobun dev --watch",
		"dev:hmr": "concurrently \"bun run hmr\" \"bun run start\" \"tsr watch\"",
		"hmr": "vite --port 5173",

		"release:extract": "rm -rf .release && mkdir -p .release && zstd -d -c artifacts/*.tar.zst | tar -x -C .release",
		"release:start": "$(find .release -type f -name launcher | head -n1)",

		"build:dev": "vite build && electrobun build",
		"build:canary": "vite build && electrobun build --env=canary",

		"generate-routes": "tsr generate",
		"watch-routes": "tsr watch",

		"install:canary": "./scripts/install-canary-desktop.sh",

		"build:canary:install": "vite build && electrobun build --env=canary && bun run release:extract && ./scripts/install-canary-desktop.sh"
	},
	"dependencies": {
		"@base-ui/react": "^1.7.0",
		"@elysiajs/cors": "^1.4.2",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/roboto": "^5.3.0",
		"@neondatabase/serverless": "^1.1.0",
		"@phosphor-icons/react": "^2.1.10",
		"@tanstack/react-form": "^1.33.3",
		"@tanstack/react-query": "^5.101.4",
		"@tanstack/react-router": "^1.170.19",
		"better-auth": "^1.6.25",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"d3-delaunay": "^6.0.4",
		"dotenv": "^17.4.2",
		"drizzle": "^1.4.0",
		"drizzle-orm": "^1.0.0-rc.4",
		"electrobun": "^2.0.1",
		"elysia": "^1.4.29",
		"elysiajs": "^0.0.0",
		"lucide-react": "^1.31.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-error-boundary": "^6.1.3",
		"shadcn": "^4.16.1",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@tanstack/router-cli": "^1.167.22",
		"@tanstack/router-generator": "^1.167.22",
		"@tanstack/router-plugin": "^1.168.24",
		"@types/bun": "latest",
		"@types/d3-delaunay": "^6.0.4",
		"@types/react": "^18.3.12",
		"@types/react-dom": "^18.3.1",
		"@vitejs/plugin-react": "^4.3.4",
		"concurrently": "^9.1.0",
		"drizzle-kit": "^1.0.0-rc.4",
		"tailwindcss": "^4.1.12",
		"@tailwindcss/vite": "^4.1.12",
		"tsx": "^4.23.5",
		"typescript": "^5.7.2",
		"vite": "^6.0.3"
	}
}
